VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Required for /api/executive/* (Drizzle). Never prefix with VITE_.
# Supabase → Project Settings → Database → Connection string → URI
# Prefer Session pooler (port 5432) or Direct. Transaction pooler (6543) needs extra pgBouncer settings.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Gmail SMTP for transactional email (/api/send-email + KA payment reminders)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Public app origin for email deep links (optional on Vercel — falls back to VERCEL_URL)
# APP_URL=https://your-production-domain.com

# Cron auth for GET /api/key-account/payment-notifications
# Prefer setting CRON_SECRET in Vercel (auto-sent as Authorization: Bearer …).
# KA_PAYMENT_REMINDER_CRON_SECRET can be the same value for manual ?secret= / x-cron-secret tests.
CRON_SECRET=
KA_PAYMENT_REMINDER_CRON_SECRET=
